<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="v2rayN"
    Width="940"
    Height="620"
    MinWidth="760"
    MinHeight="520"
    x:DataType="vms:MainWindowViewModel"
    Background="#11162A"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    ExtendClientAreaToDecorationsHint="True"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--
        Secure Connect dashboard, 1:1 with the prototype.
        Palette: bg #0C1020 · window #11162A · surface #161C35 · elevated #1D2647
                 line #273055 · fg #E8EBF6 · muted #8B95B4 · faint #5B648A
                 accent #37D3C2 · accent-2 #4F8CFF · warn #F5B83D · danger #FF5D6C
        Window chrome: no OS title bar (BorderOnly keeps the native frame, shadow,
        rounded corners and resize edges); the top bar is our own and is marked as
        the drag area with WindowDecorationProperties.ElementRole="TitleBar".
    -->
    <Window.Resources>
        <FontFamily x:Key="ScSans">avares://v2rayN/Assets/Fonts#Manrope</FontFamily>
        <FontFamily x:Key="ScMono">avares://v2rayN/Assets/Fonts#IBM Plex Mono</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <!-- Flat button: no theme chrome, just our own background/border. -->
        <Style Selector="Button.sc">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Title bar: caption buttons and menu -->
        <Style Selector="Button.cap">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.cap Border.box">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.cap Path">
            <Setter Property="Stroke" Value="#5B648A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.cap:pointerover Border.box">
            <Setter Property="BorderBrush" Value="#5B648A" />
        </Style>
        <Style Selector="Button.cap:pointerover Path">
            <Setter Property="Stroke" Value="#E8EBF6" />
        </Style>
        <Style Selector="Button.cap.close:pointerover Border.box">
            <Setter Property="BorderBrush" Value="#FF5D6C" />
            <Setter Property="Background" Value="#33FF5D6C" />
        </Style>
        <Style Selector="Menu#mainMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="Menu#mainMenu > MenuItem">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Profile cards -->
        <Style Selector="ListBox#lstCards">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#lstCards ListBoxItem">
            <Setter Property="Padding" Value="11,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox#lstCards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#lstCards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#161C35" />
        </Style>
        <Style Selector="ListBox#lstCards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#3D63B3" />
        </Style>
        <Style Selector="ListBox#lstCards ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#3D63B3" />
        </Style>

        <!-- Import: dashed outline -->
        <Style Selector="Button.import Rectangle">
            <Setter Property="Stroke" Value="#273055" />
        </Style>
        <Style Selector="Button.import TextBlock">
            <Setter Property="Foreground" Value="#8B95B4" />
        </Style>
        <Style Selector="Button.import:pointerover Rectangle">
            <Setter Property="Stroke" Value="#5B648A" />
        </Style>
        <Style Selector="Button.import:pointerover TextBlock">
            <Setter Property="Foreground" Value="#E8EBF6" />
        </Style>

        <!-- Settings gear and the panel's close button -->
        <Style Selector="Button.gear">
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.gear Path">
            <Setter Property="Stroke" Value="#8B95B4" />
        </Style>
        <Style Selector="Button.gear:pointerover">
            <Setter Property="BorderBrush" Value="#5B648A" />
        </Style>
        <Style Selector="Button.gear:pointerover Path">
            <Setter Property="Stroke" Value="#E8EBF6" />
        </Style>

        <!-- Connect dial: spinning arc while connecting -->
        <Style Selector="Ellipse.spin">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Status strip TUN toggle -->
        <Style Selector="Button.tun:pointerover TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <!-- Settings panel -->
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="#5B648A" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E8EBF6" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#8B95B4" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#8B95B4" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,5,5,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#1D2647" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tagx">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#5B648A" />
        </Style>
        <Style Selector="Button.tagx:pointerover">
            <Setter Property="Background" Value="#273055" />
        </Style>
        <Style Selector="TextBox.add">
            <Setter Property="FontFamily" Value="avares://v2rayN/Assets/Fonts#IBM Plex Mono" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8EBF6" />
        </Style>

        <!-- Prototype toggle: 42x24 pill, teal when on (amber for the kill switch). -->
        <Style Selector="ToggleButton.sct">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="track"
                        Width="42"
                        Height="24"
                        Background="#161C35"
                        BorderBrush="#273055"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Ellipse
                            Name="knob"
                            Width="18"
                            Height="18"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="#5B648A" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.sct:checked /template/ Border#track">
            <Setter Property="Background" Value="#1F4F5C" />
            <Setter Property="BorderBrush" Value="#319296" />
        </Style>
        <Style Selector="ToggleButton.sct:checked /template/ Ellipse#knob">
            <Setter Property="Margin" Value="20,0,0,0" />
            <Setter Property="Fill" Value="#37D3C2" />
        </Style>
        <Style Selector="ToggleButton.sct.warn:checked /template/ Border#track">
            <Setter Property="Background" Value="#504537" />
            <Setter Property="BorderBrush" Value="#A38247" />
        </Style>
        <Style Selector="ToggleButton.sct.warn:checked /template/ Ellipse#knob">
            <Setter Property="Fill" Value="#F5B83D" />
        </Style>

        <!-- Small icon buttons (cards, pickers) -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.icon Path">
            <Setter Property="Fill" Value="#8B95B4" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="#1D2647" />
        </Style>
        <Style Selector="Button.icon:pointerover Path">
            <Setter Property="Fill" Value="#E8EBF6" />
        </Style>

        <!-- Settings row that opens a page -->
        <Style Selector="Button.row">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.row Path">
            <Setter Property="Stroke" Value="#5B648A" />
        </Style>
        <Style Selector="Button.row:pointerover Path">
            <Setter Property="Stroke" Value="#E8EBF6" />
        </Style>

        <!-- Routes: rule cards -->
        <Style Selector="Border.card">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,12,10,12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.act">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4F8CFF" />
        </Style>
        <Style Selector="TextBlock.act.direct">
            <Setter Property="Foreground" Value="#37D3C2" />
        </Style>
        <Style Selector="TextBlock.act.block">
            <Setter Property="Foreground" Value="#FF5D6C" />
        </Style>

        <!-- Rule editor: text fields, segmented choices, protocol chips -->
        <Style Selector="TextBox.field">
            <Setter Property="FontFamily" Value="avares://v2rayN/Assets/Fonts#IBM Plex Mono" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8EBF6" />
        </Style>
        <Style Selector="TextBox.multi">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="MaxHeight" Value="140" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="RadioButton.seg, ToggleButton.chip">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="segBox"
                        Padding="12,6"
                        Background="#161C35"
                        BorderBrush="#273055"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#8B95B4" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg:pointerover /template/ Border#segBox, ToggleButton.chip:pointerover /template/ Border#segBox">
            <Setter Property="BorderBrush" Value="#5B648A" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#segBox, ToggleButton.chip:checked /template/ Border#segBox">
            <Setter Property="Background" Value="#1D2647" />
            <Setter Property="BorderBrush" Value="#3D63B3" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#E8EBF6" />
        </Style>
        <Style Selector="RadioButton.seg.proxy:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#4F8CFF" />
        </Style>
        <Style Selector="RadioButton.seg.direct:checked /template/ Border#segBox">
            <Setter Property="BorderBrush" Value="#319296" />
        </Style>
        <Style Selector="RadioButton.seg.direct:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#37D3C2" />
        </Style>
        <Style Selector="RadioButton.seg.block:checked /template/ Border#segBox">
            <Setter Property="BorderBrush" Value="#9B3B4A" />
        </Style>
        <Style Selector="RadioButton.seg.block:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#FF5D6C" />
        </Style>

        <!-- Panel footer buttons -->
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#37D3C2" />
        </Style>
        <Style Selector="Button.primary TextBlock">
            <Setter Property="Foreground" Value="#0C1020" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#5BE0D2" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#161C35" />
            <Setter Property="BorderBrush" Value="#273055" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ghost TextBlock">
            <Setter Property="Foreground" Value="#8B95B4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="BorderBrush" Value="#5B648A" />
        </Style>
        <Style Selector="Button.ghost:pointerover TextBlock">
            <Setter Property="Foreground" Value="#E8EBF6" />
        </Style>
        <Style Selector="Button.ghost.danger TextBlock">
            <Setter Property="Foreground" Value="#FF5D6C" />
        </Style>
        <Style Selector="Button.sc:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Running programs picker -->
        <Style Selector="ListBox#lstProcesses">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#lstProcesses ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox#lstProcesses ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#lstProcesses ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D2647" />
        </Style>
        <Style Selector="ListBox#lstProcesses ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D2647" />
        </Style>
    </Window.Styles>

    <dialogHost:DialogHost
        CloseOnClickAway="True"
        DisableOpeningAnimation="True"
        FontFamily="{StaticResource ScSans}">
        <Panel>
            <DockPanel>
                <!-- ===== Title bar (drag area) ===== -->
                <Border
                    x:Name="titleBar"
                    Height="44"
                    Background="#11162A"
                    BorderBrush="#273055"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top"
                    WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Border
                                Width="22"
                                Height="22"
                                BoxShadow="inset 0 0 0 1 #0FFFFFFF"
                                CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#37D3C2" />
                                        <GradientStop Offset="1" Color="#4F8CFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#E8EBF6"
                                LetterSpacing="0.2"
                                Text="v2rayN" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#8B95B4"
                                Text="Secure Connect" />
                        </StackPanel>

                        <Button
                            x:Name="btnNewUpdate"
                            Grid.Column="1"
                            Height="22"
                            Margin="14,0,0,0"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="#1D2647"
                            BorderBrush="#3D63B3"
                            BorderThickness="1"
                            Classes="sc"
                            CornerRadius="11"
                            IsVisible="False"
                            WindowDecorationProperties.ElementRole="User">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#4F8CFF"
                                Text="{x:Static resx:ResUI.menuNewUpdate}" />
                        </Button>

                        <!-- The theme/language control lives behind the menu (opened from code). -->
                        <ContentControl
                            x:Name="conTheme"
                            Grid.Column="2"
                            Width="0"
                            HorizontalAlignment="Right"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <StackPanel
                            Grid.Column="3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Menu
                                x:Name="mainMenu"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                WindowDecorationProperties.ElementRole="User">
                                <MenuItem x:Name="menuMain" ToolTip.Tip="{x:Static resx:ResUI.ScMenu}">
                                    <MenuItem.Header>
                                        <Path
                                            Width="12"
                                            Height="10"
                                            Data="M 0 1 H 12 M 0 5 H 12 M 0 9 H 12"
                                            Stroke="#8B95B4"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.4" />
                                    </MenuItem.Header>
                                    <MenuItem Header="{x:Static resx:ResUI.menuServers}">
                                        <MenuItem
                                            x:Name="menuAddServerViaClipboard"
                                            Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                            InputGesture="Ctrl+V" />
                                        <MenuItem
                                            x:Name="menuAddServerViaScan"
                                            Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                            InputGesture="Ctrl+S" />
                                        <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                        <Separator />
                                        <MenuItem x:Name="menuAddCustomServer" Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                        <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                        <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                        <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                        <Separator />
                                        <MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                        <MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                        <MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                        <MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                        <MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                        <MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                        <MenuItem x:Name="menuAddMasqueServer" Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                        <MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                        <MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                        <Separator />
                                        <MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                        <MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                        <MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                    </MenuItem>

                                    <MenuItem Header="{x:Static resx:ResUI.menuSubscription}">
                                        <MenuItem x:Name="menuSubSetting" Header="{x:Static resx:ResUI.menuSubSetting}" />
                                        <Separator />
                                        <MenuItem x:Name="menuSubUpdate" Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                        <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                        <MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                        <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                    </MenuItem>

                                    <MenuItem Header="{x:Static resx:ResUI.menuSetting}">
                                        <MenuItem x:Name="menuOptionSetting" Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                        <MenuItem x:Name="menuRoutingSetting" Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                        <MenuItem x:Name="menuDNSSetting" Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                        <MenuItem x:Name="menuFullConfigTemplate" Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                        <MenuItem
                                            x:Name="menuGlobalHotkeySetting"
                                            Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}"
                                            IsVisible="{Binding BlIsWindows}" />
                                        <MenuItem x:Name="menuAppearance" Header="Theme / Language" />
                                        <Separator />
                                        <MenuItem
                                            x:Name="menuRebootAsAdmin"
                                            Header="{x:Static resx:ResUI.menuRebootAsAdmin}"
                                            IsVisible="{Binding BlIsWindows}" />
                                        <MenuItem
                                            x:Name="menuSettingsSetUWP"
                                            Header="{x:Static resx:ResUI.TbSettingsSetUWP}"
                                            IsVisible="{Binding BlIsWindows}" />
                                        <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                            <MenuItem x:Name="menuRegionalPresetsDefault" Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                            <MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                            <MenuItem x:Name="menuRegionalPresetsIran" Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                        </MenuItem>
                                        <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                        <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                    </MenuItem>

                                    <MenuItem x:Name="menuHelp" Header="{x:Static resx:ResUI.menuHelp}">
                                        <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                        <Separator />
                                    </MenuItem>

                                    <Separator />
                                    <MenuItem x:Name="menuReload" Header="{x:Static resx:ResUI.menuReload}" />
                                    <MenuItem x:Name="menuStopCore" Header="{x:Static resx:ResUI.ScDisconnect}" />
                                    <Separator />
                                    <MenuItem x:Name="menuPromotion" Header="{x:Static resx:ResUI.menuPromotion}" />
                                    <MenuItem x:Name="menuClose" Header="{x:Static resx:ResUI.menuExit}" />
                                </MenuItem>
                            </Menu>

                            <Button
                                x:Name="btnMinimize"
                                Classes="sc cap"
                                ToolTip.Tip="{x:Static resx:ResUI.ScMinimize}"
                                WindowDecorationProperties.ElementRole="User">
                                <Border Classes="box">
                                    <Path
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 H 6" />
                                </Border>
                            </Button>
                            <Button
                                x:Name="btnMaximize"
                                Classes="sc cap"
                                ToolTip.Tip="{x:Static resx:ResUI.ScMaximize}"
                                WindowDecorationProperties.ElementRole="User">
                                <Border Classes="box">
                                    <Path
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0.5 0.5 H 5.5 V 5.5 H 0.5 Z" />
                                </Border>
                            </Button>
                            <Button
                                x:Name="btnClose"
                                Classes="sc cap close"
                                ToolTip.Tip="{x:Static resx:ResUI.ScClose}"
                                WindowDecorationProperties.ElementRole="User">
                                <Border Classes="box">
                                    <Path
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 L 6 6 M 6 0 L 0 6" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Status strip ===== -->
                <Border
                    Padding="16,10"
                    Background="#0E1325"
                    BorderBrush="#273055"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Border
                                x:Name="dotCore"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Background="#5B648A"
                                CornerRadius="4" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#8B95B4"
                                Text="{x:Static resx:ResUI.ScCore}" />
                            <TextBlock
                                x:Name="txtCore"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ScMono}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#E8EBF6"
                                Text="sing-box" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="7">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#5B648A"
                                Text="↓" />
                            <TextBlock
                                x:Name="txtDown"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ScMono}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#E8EBF6"
                                Text="0.0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#8B95B4"
                                Text="{x:Static resx:ResUI.ScMbps}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="7">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#5B648A"
                                Text="↑" />
                            <TextBlock
                                x:Name="txtUp"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ScMono}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#E8EBF6"
                                Text="0.0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#8B95B4"
                                Text="{x:Static resx:ResUI.ScMbps}" />
                        </StackPanel>
                        <Button
                            x:Name="btnTun"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Classes="sc tun"
                            ToolTip.Tip="{x:Static resx:ResUI.ScTunTip}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8B95B4"
                                    Text="TUN" />
                                <TextBlock
                                    x:Name="txtTun"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ScMono}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#E8EBF6"
                                    Text="singbox_tun" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Body: profile rail + connect stage ===== -->
                <Grid ColumnDefinitions="248,*">
                    <Border
                        Grid.Column="0"
                        Background="#0F1426"
                        BorderBrush="#273055"
                        BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock
                                Grid.Row="0"
                                Margin="16,14,16,8"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#5B648A"
                                LetterSpacing="1.5"
                                Text="{x:Static resx:ResUI.ScProfiles}" />
                            <ListBox
                                x:Name="lstCards"
                                Grid.Row="1"
                                Padding="10,0,10,2"
                                Background="Transparent"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionMode="Single">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="menuCtxEdit" Header="{x:Static resx:ResUI.ScEdit}" />
                                        <MenuItem x:Name="menuCtxPing" Header="{x:Static resx:ResUI.ScPing}" />
                                        <MenuItem x:Name="menuCtxShare" Header="{x:Static resx:ResUI.ScCopyShareLink}" />
                                        <Separator />
                                        <MenuItem x:Name="menuCtxDelete" Header="{x:Static resx:ResUI.ScDelete}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                VerticalAlignment="Center"
                                                Background="#1D2647"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource ScMono}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#4F8CFF"
                                                    LetterSpacing="0.5"
                                                    Text="{ReflectionBinding CountryCode}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="10,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    FontSize="13.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="#E8EBF6"
                                                    Text="{ReflectionBinding Remarks}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="{StaticResource ScMono}"
                                                    FontSize="11"
                                                    Foreground="#8B95B4"
                                                    Text="{ReflectionBinding ProtocolInfo}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    FontFamily="{StaticResource ScMono}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#37D3C2"
                                                    Text="{ReflectionBinding DelayVal}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource ScMono}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#8B95B4"
                                                    IsVisible="{ReflectionBinding DelayVal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Text="{x:Static resx:ResUI.ScMs}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button
                                x:Name="btnImport"
                                Grid.Row="2"
                                Height="36"
                                Margin="12,6,12,12"
                                HorizontalAlignment="Stretch"
                                Classes="sc import">
                                <Panel>
                                    <Rectangle
                                        RadiusX="10"
                                        RadiusY="10"
                                        StrokeDashArray="4,3"
                                        StrokeThickness="1" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Static resx:ResUI.ScImportClipboard}" />
                                </Panel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Background="#11162A">
                        <StackPanel
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="18">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <TextBlock
                                    x:Name="txtState"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#8B95B4"
                                    LetterSpacing="2.2"
                                    Text="{x:Static resx:ResUI.ScStateDisconnected}" />
                                <TextBlock
                                    x:Name="txtServerName"
                                    MaxWidth="420"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#E8EBF6"
                                    Text="-"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button
                                x:Name="btnDial"
                                Width="212"
                                Height="212"
                                HorizontalAlignment="Center"
                                Classes="sc"
                                CornerRadius="106"
                                ToolTip.Tip="{x:Static resx:ResUI.ScConnectTip}">
                                <Panel Width="212" Height="212">
                                    <!-- connected glow -->
                                    <Border
                                        x:Name="dialGlow"
                                        Width="196"
                                        Height="196"
                                        Background="#161C35"
                                        BoxShadow="0 0 40 0 #2E37D3C2, 0 0 0 4 #1437D3C2"
                                        CornerRadius="98"
                                        IsVisible="False" />
                                    <!-- dial disc -->
                                    <Ellipse
                                        x:Name="dialDisc"
                                        Width="196"
                                        Height="196"
                                        Stroke="#273055"
                                        StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush
                                                Center="50%,42%"
                                                GradientOrigin="50%,42%"
                                                RadiusX="62%"
                                                RadiusY="62%">
                                                <GradientStop Offset="0" Color="#1D294D" />
                                                <GradientStop Offset="1" Color="#161C35" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- outer ring: connected -->
                                    <Ellipse
                                        x:Name="ringOn"
                                        Width="208"
                                        Height="208"
                                        IsVisible="False"
                                        Stroke="#37D3C2"
                                        StrokeThickness="2" />
                                    <!-- outer ring: connecting (spinning arc) -->
                                    <Ellipse
                                        x:Name="ringBusy"
                                        Width="208"
                                        Height="208"
                                        IsVisible="False"
                                        Stroke="#4F8CFF"
                                        StrokeDashArray="245,82"
                                        StrokeThickness="2" />
                                    <!-- inner disc -->
                                    <Ellipse
                                        Width="150"
                                        Height="150"
                                        Stroke="#273055"
                                        StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush
                                                Center="50%,35%"
                                                GradientOrigin="50%,35%"
                                                RadiusX="70%"
                                                RadiusY="70%">
                                                <GradientStop Offset="0" Color="#1D2647" />
                                                <GradientStop Offset="1" Color="#11162A" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <Viewbox
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path
                                                    x:Name="iconPower"
                                                    Data="M 12 3 V 12 M 6.5 7 A 8 8 0 1 0 17.5 7"
                                                    Stroke="#8B95B4"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="2" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock
                                            x:Name="txtVerb"
                                            HorizontalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#8B95B4"
                                            LetterSpacing="1"
                                            Text="{x:Static resx:ResUI.ScConnectVerb}" />
                                        <TextBlock
                                            x:Name="txtTimer"
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource ScMono}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#37D3C2"
                                            IsVisible="False"
                                            LetterSpacing="0.5"
                                            Text="00:00:00" />
                                    </StackPanel>
                                </Panel>
                            </Button>

                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Border
                                    Padding="12,7"
                                    Background="#161C35"
                                    BorderBrush="#273055"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Border
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Background="#5B648A"
                                            CornerRadius="4" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#8B95B4"
                                            Text="IP" />
                                        <TextBlock
                                            x:Name="txtIp"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource ScMono}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#E8EBF6"
                                            LetterSpacing="0.3"
                                            Text="—" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="chipLock"
                                    Padding="12,7"
                                    Background="#161C35"
                                    BorderBrush="#273055"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Border
                                            x:Name="dotLock"
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Background="#5B648A"
                                            CornerRadius="4" />
                                        <TextBlock
                                            x:Name="txtKill"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#8B95B4"
                                            Text="{x:Static resx:ResUI.ScChipKillOff}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button
                            x:Name="btnSettings"
                            Width="34"
                            Height="34"
                            Margin="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Classes="sc gear"
                            CornerRadius="10"
                            ToolTip.Tip="{x:Static resx:ResUI.ScSettings}">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z M 19.4 15 a 1.65 1.65 0 0 0 0.33 1.82 l 0.06 0.06 a 2 2 0 1 1 -2.83 2.83 l -0.06 -0.06 a 1.65 1.65 0 0 0 -1.82 -0.33 a 1.65 1.65 0 0 0 -1 1.51 V 21 a 2 2 0 0 1 -4 0 v -0.09 A 1.65 1.65 0 0 0 9 19.4 a 1.65 1.65 0 0 0 -1.82 0.33 l -0.06 0.06 a 2 2 0 1 1 -2.83 -2.83 l 0.06 -0.06 a 1.65 1.65 0 0 0 0.33 -1.82 a 1.65 1.65 0 0 0 -1.51 -1 H 3 a 2 2 0 0 1 0 -4 h 0.09 A 1.65 1.65 0 0 0 4.6 9 a 1.65 1.65 0 0 0 -0.33 -1.82 l -0.06 -0.06 a 2 2 0 1 1 2.83 -2.83 l 0.06 0.06 a 1.65 1.65 0 0 0 1.82 0.33 H 9 a 1.65 1.65 0 0 0 1 -1.51 V 3 a 2 2 0 0 1 4 0 v 0.09 a 1.65 1.65 0 0 0 1 1.51 a 1.65 1.65 0 0 0 1.82 -0.33 l 0.06 -0.06 a 2 2 0 1 1 2.83 2.83 l -0.06 0.06 a 1.65 1.65 0 0 0 -0.33 1.82 V 9 a 1.65 1.65 0 0 0 1.51 1 H 21 a 2 2 0 0 1 0 4 h -0.09 a 1.65 1.65 0 0 0 -1.51 1 z"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>
            </DockPanel>

            <!-- ===== Settings panel (gear) ===== -->
            <Border
                x:Name="settingsOverlay"
                Padding="18"
                Background="#B8080B18"
                IsVisible="False">
                <Panel>
                <Border
                    x:Name="settingsPanel"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#11162A"
                    BorderBrush="#273055"
                    BorderThickness="1"
                    BoxShadow="0 24 60 0 #73000000"
                    ClipToBounds="True"
                    CornerRadius="14">
                    <DockPanel>
                        <Border
                            Padding="16,15"
                            BorderBrush="#273055"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#E8EBF6"
                                    Text="{x:Static resx:ResUI.ScSettings}" />
                                <Button
                                    x:Name="btnSettingsClose"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Classes="sc gear"
                                    CornerRadius="8"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScClose}">
                                    <Path
                                        Data="M 0 0 L 9 9 M 9 0 L 0 9"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.5" />
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Classes="section">
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="{x:Static resx:ResUI.ScNetworkLockSection}" />
                                        <Grid Margin="0,7" ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScKillSwitch}" />
                                                <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScKillSwitchSub}" />
                                            </StackPanel>
                                            <ToggleButton
                                                x:Name="tglKill"
                                                Grid.Column="1"
                                                Classes="sct warn" />
                                        </Grid>
                                        <Grid Margin="0,7" ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScAllowLan}" />
                                                <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScAllowLanSub}" />
                                            </StackPanel>
                                            <ToggleButton
                                                x:Name="tglLan"
                                                Grid.Column="1"
                                                Classes="sct" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="section">
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="{x:Static resx:ResUI.ScSplitSection}" />
                                        <WrapPanel Margin="0,7,0,2" Orientation="Horizontal">
                                            <RadioButton
                                                x:Name="rbSplitWhitelist"
                                                Classes="seg direct"
                                                Content="{x:Static resx:ResUI.ScSplitWhitelist}"
                                                GroupName="splitMode"
                                                ToolTip.Tip="{x:Static resx:ResUI.ScSplitWhitelistTip}" />
                                            <RadioButton
                                                x:Name="rbSplitBypass"
                                                Classes="seg"
                                                Content="{x:Static resx:ResUI.ScSplitBypass}"
                                                GroupName="splitMode"
                                                ToolTip.Tip="{x:Static resx:ResUI.ScSplitBypassTip}" />
                                        </WrapPanel>
                                        <Grid Margin="0,7" ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScApps}" />
                                                <TextBlock
                                                    x:Name="txtSplitAppsSub"
                                                    Classes="sub"
                                                    Text="{x:Static resx:ResUI.ScSplitAppsSubWhitelist}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    x:Name="btnPickProgram"
                                                    Width="28"
                                                    Height="28"
                                                    Classes="sc gear"
                                                    CornerRadius="8"
                                                    ToolTip.Tip="{x:Static resx:ResUI.ScAddRunningProgram}">
                                                    <Path
                                                        Data="M 0 5 H 10 M 5 0 V 10"
                                                        StrokeLineCap="Round"
                                                        StrokeThickness="1.6" />
                                                </Button>
                                                <Button
                                                    x:Name="btnPickFolder"
                                                    Width="28"
                                                    Height="28"
                                                    Classes="sc gear"
                                                    CornerRadius="8"
                                                    ToolTip.Tip="{x:Static resx:ResUI.ScAddFolder}">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="24" Height="24">
                                                            <Path
                                                                Data="M 22 19 a 2 2 0 0 1 -2 2 H 4 a 2 2 0 0 1 -2 -2 V 5 a 2 2 0 0 1 2 -2 h 5 l 2 3 h 9 a 2 2 0 0 1 2 2 z"
                                                                StrokeJoin="Round"
                                                                StrokeThickness="2" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl x:Name="lstBypassApps" Margin="0,1,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Border Classes="tag">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontFamily="{StaticResource ScMono}"
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="#E8EBF6"
                                                                Text="{Binding}" />
                                                            <Button
                                                                Classes="sc tagx"
                                                                Tag="{Binding}"
                                                                ToolTip.Tip="{x:Static resx:ResUI.ScRemove}">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="#8B95B4"
                                                                    Text="×" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox
                                            x:Name="txtAddApp"
                                            Classes="add"
                                            PlaceholderText="{x:Static resx:ResUI.ScAddAppPlaceholder}" />

                                        <TextBlock
                                            Margin="0,13,0,8"
                                            Classes="label"
                                            Text="{x:Static resx:ResUI.ScSubnets}" />
                                        <TextBlock
                                            x:Name="txtSplitSubnetsSub"
                                            Margin="0,-6,0,8"
                                            Classes="sub"
                                            Text="{x:Static resx:ResUI.ScSplitSubnetsSubWhitelist}" />
                                        <ItemsControl x:Name="lstBypassSubnets">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Border Classes="tag">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontFamily="{StaticResource ScMono}"
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="#4F8CFF"
                                                                Text="{Binding}" />
                                                            <Button
                                                                Classes="sc tagx"
                                                                Tag="{Binding}"
                                                                ToolTip.Tip="{x:Static resx:ResUI.ScRemove}">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="#8B95B4"
                                                                    Text="×" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox
                                            x:Name="txtAddSubnet"
                                            Classes="add"
                                            PlaceholderText="{x:Static resx:ResUI.ScAddSubnetPlaceholder}" />

                                        <TextBlock
                                            x:Name="txtSplitHint"
                                            Classes="hint"
                                            Text="{x:Static resx:ResUI.ScSplitHintWhitelist}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="section">
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="{x:Static resx:ResUI.ScRoutingSection}" />
                                        <Grid Margin="0,7" ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScUseRoutingRules}" />
                                                <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScUseRoutingRulesSub}" />
                                            </StackPanel>
                                            <ToggleButton
                                                x:Name="tglRoutingRules"
                                                Grid.Column="1"
                                                Classes="sct" />
                                        </Grid>
                                        <Button x:Name="btnOpenRoutes" Classes="sc row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScRoutes}" />
                                                    <TextBlock
                                                        x:Name="txtRoutesSummary"
                                                        Classes="sub"
                                                        Text="{x:Static resx:ResUI.ScRoutesSub}" />
                                                </StackPanel>
                                                <Path
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 5 5 L 0 10"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="1.6" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Classes="section">
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="{x:Static resx:ResUI.ScTunnelSection}" />
                                        <Grid Margin="0,7" ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScTunMode}" />
                                                <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScTunModeSub}" />
                                            </StackPanel>
                                            <ToggleButton
                                                x:Name="tglTun"
                                                Grid.Column="1"
                                                Classes="sct" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="section" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="{x:Static resx:ResUI.ScInterfaceSection}" />
                                        <Grid Margin="0,7" ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScLanguage}" />
                                                <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScLanguageSub}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="cmbLanguage"
                                                Grid.Column="1"
                                                Width="150"
                                                VerticalAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{ReflectionBinding Display}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Routes page (NekoBox style) ===== -->
                <Border
                    x:Name="routesPanel"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#11162A"
                    BorderBrush="#273055"
                    BorderThickness="1"
                    BoxShadow="0 24 60 0 #73000000"
                    ClipToBounds="True"
                    CornerRadius="14"
                    IsVisible="False">
                    <DockPanel>
                        <Border
                            Padding="12,12,16,12"
                            BorderBrush="#273055"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Button
                                    x:Name="btnRoutesBack"
                                    Width="28"
                                    Height="28"
                                    Classes="sc gear"
                                    CornerRadius="8"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScBack}">
                                    <Path
                                        Data="M 5 0 L 0 5 L 5 10"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.6" />
                                </Button>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#E8EBF6"
                                    Text="{x:Static resx:ResUI.ScRoutes}" />
                                <ComboBox
                                    x:Name="cmbRoutingSet"
                                    Grid.Column="2"
                                    Width="170"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScRoutingSetTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding Remarks}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    x:Name="btnRouteAdd"
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Classes="sc gear"
                                    CornerRadius="8"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScAddRule}">
                                    <Path
                                        Data="M 0 5 H 10 M 5 0 V 10"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.6" />
                                </Button>
                                <Button
                                    x:Name="btnRoutesMenu"
                                    Grid.Column="4"
                                    Width="28"
                                    Height="28"
                                    Classes="sc gear"
                                    CornerRadius="8"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScRoutesMenuTip}">
                                    <Path
                                        Data="M 0 0 L 0.01 0 M 5 0 L 5.01 0 M 10 0 L 10.01 0"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2.6" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{x:Static resx:ResUI.ScPresetRussia}" Tag="preset-russia" />
                                            <MenuItem Header="{x:Static resx:ResUI.ScPresetIran}" Tag="preset-iran" />
                                            <MenuItem Header="{x:Static resx:ResUI.ScPresetDefault}" Tag="preset-default" />
                                            <Separator />
                                            <MenuItem Header="{x:Static resx:ResUI.ScAdvancedRouting}" Tag="advanced" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                        <Border
                            Margin="14,12,14,4"
                            Padding="14,11"
                            Background="#161C35"
                            BorderBrush="#273055"
                            BorderThickness="1"
                            CornerRadius="12"
                            DockPanel.Dock="Top">
                            <TextBlock
                                FontSize="12"
                                Foreground="#8B95B4"
                                LineHeight="17"
                                Text="{x:Static resx:ResUI.ScRoutesHint}"
                                TextWrapping="Wrap" />
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,8,14,6">
                                <ItemsControl x:Name="lstRoutes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dto:RouteRuleModel">
                                            <Border Classes="card">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="#E8EBF6"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="2">
                                                        <Button
                                                            Classes="sc icon"
                                                            Tag="edit"
                                                            ToolTip.Tip="{x:Static resx:ResUI.ScEdit}">
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 3 17.25 V 21 h 3.75 L 17.81 9.94 l -3.75 -3.75 L 3 17.25 z M 20.71 7.04 a 1 1 0 0 0 0 -1.41 l -2.34 -2.34 a 1 1 0 0 0 -1.41 0 l -1.83 1.83 l 3.75 3.75 l 1.83 -1.83 z" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button
                                                            Classes="sc icon"
                                                            Tag="copy"
                                                            ToolTip.Tip="{x:Static resx:ResUI.ScDuplicate}">
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 16 1 H 4 c -1.1 0 -2 0.9 -2 2 v 14 h 2 V 3 h 12 V 1 z m 3 4 H 8 c -1.1 0 -2 0.9 -2 2 v 14 c 0 1.1 0.9 2 2 2 h 11 c 1.1 0 2 -0.9 2 -2 V 7 c 0 -1.1 -0.9 -2 -2 -2 z m 0 16 H 8 V 7 h 11 v 14 z" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Margin="0,8,12,0"
                                                        FontFamily="{StaticResource ScMono}"
                                                        FontSize="11.5"
                                                        Foreground="#8B95B4"
                                                        LineHeight="17"
                                                        Text="{Binding Summary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="0,8,0,0"
                                                        Classes="act"
                                                        Classes.block="{Binding IsBlock}"
                                                        Classes.direct="{Binding IsDirect}"
                                                        Text="{Binding ActionText}" />
                                                    <ToggleButton
                                                        Grid.Row="1"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Classes="sct"
                                                        IsChecked="{Binding Enabled, Mode=OneWay}"
                                                        Tag="toggle"
                                                        ToolTip.Tip="{x:Static resx:ResUI.ScEnableDisable}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="txtRoutesEmpty"
                                    Margin="0,10,0,14"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#5B648A"
                                    IsVisible="False"
                                    Text="{x:Static resx:ResUI.ScRoutesEmpty}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Rule editor ===== -->
                <Border
                    x:Name="ruleEditorPanel"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#11162A"
                    BorderBrush="#273055"
                    BorderThickness="1"
                    BoxShadow="0 24 60 0 #73000000"
                    ClipToBounds="True"
                    CornerRadius="14"
                    IsVisible="False">
                    <DockPanel>
                        <Border
                            Padding="12,12,16,12"
                            BorderBrush="#273055"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button
                                    x:Name="btnRuleBack"
                                    Width="28"
                                    Height="28"
                                    Classes="sc gear"
                                    CornerRadius="8"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScBackNoSave}">
                                    <Path
                                        Data="M 5 0 L 0 5 L 5 10"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.6" />
                                </Button>
                                <TextBlock
                                    x:Name="txtRuleEditorTitle"
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#E8EBF6"
                                    Text="{x:Static resx:ResUI.ScEditRule}" />
                                <ToggleButton
                                    x:Name="tglRuleEnabled"
                                    Grid.Column="2"
                                    Classes="sct"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScRuleEnabledTip}" />
                            </Grid>
                        </Border>
                        <Border
                            Padding="16,12"
                            BorderBrush="#273055"
                            BorderThickness="0,1,0,0"
                            DockPanel.Dock="Bottom">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                <Button
                                    x:Name="btnRuleDelete"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Classes="sc ghost danger">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.ScDelete}" />
                                </Button>
                                <Button
                                    x:Name="btnRuleUp"
                                    Grid.Column="1"
                                    Width="32"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    Classes="sc ghost"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScMoveUp}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="↑" />
                                </Button>
                                <Button
                                    x:Name="btnRuleDown"
                                    Grid.Column="2"
                                    Width="32"
                                    Padding="0"
                                    Classes="sc ghost"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScMoveDown}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="↓" />
                                </Button>
                                <TextBlock
                                    x:Name="txtRulePosition"
                                    Grid.Column="3"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ScMono}"
                                    FontSize="11"
                                    Foreground="#5B648A"
                                    Text="" />
                                <Button
                                    x:Name="btnRuleCancel"
                                    Grid.Column="4"
                                    Margin="0,0,8,0"
                                    Classes="sc ghost">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.ScCancel}" />
                                </Button>
                                <Button
                                    x:Name="btnRuleSave"
                                    Grid.Column="5"
                                    Classes="sc primary">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.ScSave}" />
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,14,16,16" Spacing="14">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScName}" />
                                    <TextBox
                                        x:Name="txtRuleName"
                                        Classes="field"
                                        FontFamily="avares://v2rayN/Assets/Fonts#Manrope"
                                        PlaceholderText="{x:Static resx:ResUI.ScRuleNamePlaceholder}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScAction}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="rbRuleProxy"
                                            Classes="seg proxy"
                                            Content="{x:Static resx:ResUI.ScActionProxy}"
                                            GroupName="ruleAction" />
                                        <RadioButton
                                            x:Name="rbRuleDirect"
                                            Classes="seg direct"
                                            Content="{x:Static resx:ResUI.ScActionBypass}"
                                            GroupName="ruleAction" />
                                        <RadioButton
                                            x:Name="rbRuleBlock"
                                            Classes="seg block"
                                            Content="{x:Static resx:ResUI.ScActionBlock}"
                                            GroupName="ruleAction" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScDomains}" />
                                    <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScDomainsSub}" />
                                    <TextBox
                                        x:Name="txtRuleDomains"
                                        Classes="field multi"
                                        PlaceholderText="geosite:category-ads-all" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScIps}" />
                                    <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScIpsSub}" />
                                    <TextBox
                                        x:Name="txtRuleIps"
                                        Classes="field multi"
                                        PlaceholderText="geoip:ru" />
                                </StackPanel>

                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScApps}" />
                                            <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScRuleAppsSub}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                x:Name="btnRulePickProgram"
                                                Width="28"
                                                Height="28"
                                                Classes="sc gear"
                                                CornerRadius="8"
                                                ToolTip.Tip="{x:Static resx:ResUI.ScAddRunningProgram}">
                                                <Path
                                                    Data="M 0 5 H 10 M 5 0 V 10"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="1.6" />
                                            </Button>
                                            <Button
                                                x:Name="btnRulePickFolder"
                                                Width="28"
                                                Height="28"
                                                Classes="sc gear"
                                                CornerRadius="8"
                                                ToolTip.Tip="{x:Static resx:ResUI.ScAddFolder}">
                                                <Viewbox Width="14" Height="14">
                                                    <Canvas Width="24" Height="24">
                                                        <Path
                                                            Data="M 22 19 a 2 2 0 0 1 -2 2 H 4 a 2 2 0 0 1 -2 -2 V 5 a 2 2 0 0 1 2 -2 h 5 l 2 3 h 9 a 2 2 0 0 1 2 2 z"
                                                            StrokeJoin="Round"
                                                            StrokeThickness="2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox
                                        x:Name="txtRuleApps"
                                        Classes="field multi"
                                        PlaceholderText="qbittorrent.exe" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScProtocol}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <ToggleButton x:Name="tglProtoHttp" Classes="chip" Content="http" />
                                        <ToggleButton x:Name="tglProtoTls" Classes="chip" Content="tls" />
                                        <ToggleButton x:Name="tglProtoQuic" Classes="chip" Content="quic" />
                                        <ToggleButton x:Name="tglProtoBt" Classes="chip" Content="bittorrent" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScPort}" />
                                        <TextBox
                                            x:Name="txtRulePort"
                                            Classes="field"
                                            PlaceholderText="443, 1000-2000" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="label" Text="{x:Static resx:ResUI.ScNetwork}" />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <RadioButton
                                                x:Name="rbNetAny"
                                                Classes="seg"
                                                Content="{x:Static resx:ResUI.ScNetworkAny}"
                                                GroupName="ruleNetwork" />
                                            <RadioButton
                                                x:Name="rbNetTcp"
                                                Classes="seg"
                                                Content="tcp"
                                                GroupName="ruleNetwork" />
                                            <RadioButton
                                                x:Name="rbNetUdp"
                                                Classes="seg"
                                                Content="udp"
                                                GroupName="ruleNetwork" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Panel>
            </Border>

            <!-- ===== Running programs picker (Apps "+") ===== -->
            <Border
                x:Name="procPickerLayer"
                Padding="18"
                Background="#99080B18"
                IsVisible="False">
                <Border
                    Width="440"
                    MaxHeight="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#11162A"
                    BorderBrush="#273055"
                    BorderThickness="1"
                    BoxShadow="0 24 60 0 #73000000"
                    ClipToBounds="True"
                    CornerRadius="14">
                    <DockPanel>
                        <Border
                            Padding="16,13"
                            BorderBrush="#273055"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="#E8EBF6"
                                        Text="{x:Static resx:ResUI.ScRunningPrograms}" />
                                    <TextBlock Classes="sub" Text="{x:Static resx:ResUI.ScRunningProgramsSub}" />
                                </StackPanel>
                                <Button
                                    x:Name="btnProcClose"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Classes="sc gear"
                                    CornerRadius="8"
                                    ToolTip.Tip="{x:Static resx:ResUI.ScClose}">
                                    <Path
                                        Data="M 0 0 L 9 9 M 9 0 L 0 9"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.5" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Padding="12,10,12,4" DockPanel.Dock="Top">
                            <TextBox
                                x:Name="txtProcSearch"
                                Classes="add"
                                PlaceholderText="{x:Static resx:ResUI.ScSearchPrograms}" />
                        </Border>
                        <TextBlock
                            x:Name="txtProcStatus"
                            Margin="16,4,16,12"
                            DockPanel.Dock="Bottom"
                            FontSize="11.5"
                            Foreground="#5B648A"
                            Text="" />
                        <ListBox
                            x:Name="lstProcesses"
                            Padding="8,4"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#E8EBF6"
                                            Text="{ReflectionBinding Name}" />
                                        <TextBlock
                                            FontFamily="{StaticResource ScMono}"
                                            FontSize="11"
                                            Foreground="#8B95B4"
                                            Text="{ReflectionBinding Path}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>
        </Panel>
    </dialogHost:DialogHost>
</Window>
